[Unit]
Description=OnPlant 5-inch display kiosk
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/onplant/onplant-robot.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/bin/bash -lc 'cd "$ONPLANT_PROJECT_DIR" && exec /usr/bin/python3 front_display_app.py'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
