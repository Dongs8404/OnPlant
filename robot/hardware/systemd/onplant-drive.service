[Unit]
Description=OnPlant LiDAR FSM drive loop
After=network-online.target onplant-display.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/onplant/onplant-robot.env
ExecStart=/bin/bash -lc 'cd "$ONPLANT_PROJECT_DIR" && exec /usr/bin/python3 lidar_fsm_drive.py'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
